# Paste these in cPanel → Setup Node.js App → Environment variables.
# Do not upload a real .env file to GitHub.

NODE_ENV=production

# Public site origin used by robots.txt and sitemap.xml
SITE_URL=https://zenithlr.com

ADMIN_EMAIL=management@zenithlr.com
ADMIN_PASSWORD=zenith2026
SESSION_SECRET=change-this-to-a-long-random-string

# Contact forms → management inbox (TMDHosting SMTP)
# On the same server, use localhost (mail.zenithlr.com is often blocked outbound).
MANAGEMENT_EMAIL=management@zenithlr.com
MAIL_FROM=management@zenithlr.com
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=management@zenithlr.com
SMTP_PASS=
